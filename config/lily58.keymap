/*
 * Reconstructed from ChazRowe/qmk_firmware's most recent
 * keyboards/planck/keymaps/chaz keymap.
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define NUMPAD 3
#define ADJUST 4

/*
 * Deliberately improbable shortcut namespace used by the eight low-profile
 * macro keys: left Shift+Control+GUI+Alt, right Alt+Shift, plus an F key.
 */
#define CHAZ_META(key) LS(LC(LG(LA(RA(RS(key))))))
#define CHAZ_META_MOD LS(LC(LG(LA(RA(RSHFT)))))

/ {
    behaviors {
        /*
         * The QMK NUMPAD key enables the layer while held, but emits Space
         * when tapped without another key. Hold-preferred matches that
         * interrupt behavior more closely than ZMK's stock layer-tap.
         */
        num_space: num_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        snip: snip {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&kp LG(R)>
                , <&macro_wait_time 500>
                , <&kp S &kp N &kp I &kp P &kp P &kp I &kp N &kp G>
                , <&kp T &kp O &kp O &kp L &kp DOT &kp E &kp X &kp E>
                , <&kp ENTER>
                , <&macro_wait_time 1000>
                , <&kp LC(PSCRN)>
                ;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
// Planck rows are shifted onto the top four Lily58 rows. The two keys under
// the displays hold Chaz's six-modifier Meta chord. The low-profile thumb
// keys send that same chord plus F1-F8, from left to right.
// ------------------------------------------------------------------------------------------------------------
// | TAB  |  Q   |  W   |  E   |  R   |  T   |                   |  Y   |  U   |  I   |  O   |  P   | ESC       |
// | BSPC |  A   |  S   |  D   |  F   |  G   |                   |  H   |  J   |  K   |  L   |  ;   | '         |
// | LSHF |  Z   |  X   |  C   |  V   |  B   |                   |  N   |  M   |  ,   |  .   |  /   | RSHF/ENT  |
// | LCTL | LGUI | LALT | LALT | LOWER| SPC/NP|   META   | | META | SPACE| RAISE| LEFT | DOWN | UP   | RCTL/RIGHT|
//                             | M+F1 | M+F2 | M+F3 | M+F4 | | M+F5 | M+F6 | M+F7 | M+F8 |
            bindings = <
&kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T                         &kp Y     &kp U     &kp I     &kp O     &kp P     &kp ESC
&kp BSPC  &kp A    &kp S    &kp D    &kp F    &kp G                         &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
&kp LSHFT &kp Z    &kp X    &kp C    &kp V    &kp B                         &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &mt RSHIFT ENTER
&kp LCTRL &kp LGUI &kp LALT &kp LALT &mo LOWER &num_space NUMPAD SPACE &kp CHAZ_META_MOD &kp CHAZ_META_MOD &kp SPACE &mo RAISE &kp LEFT &kp DOWN &kp UP &mt RCTRL RIGHT
                              &kp CHAZ_META(F1) &kp CHAZ_META(F2) &kp CHAZ_META(F3) &kp CHAZ_META(F4) &kp CHAZ_META(F5) &kp CHAZ_META(F6) &kp CHAZ_META(F7) &kp CHAZ_META(F8)
            >;
        };

        lower_layer {
            display-name = "Lower";
// ------------------------------------------------------------------------------------------------------------
// |  ~   |  !   |  @   |  #   |  $   |  %   |                   |  ^   |  &   |  *   |  (   |  )   | ESC  |
// | DEL  | F1   | F2   | F3   | F4   | F5   |                   | F6   |  _   |  +   |  {   |  }   |  |   |
// |      | F7   | F8   | F9   | F10  | F11  |                   | F12  |ISO ~ |ISO | | HOME | END  |      |
// |      |      |      |      |      |      |          | |      |      |      | HOME | PGDN | PGUP | END  |
            bindings = <
&kp TILDE &kp EXCL &kp AT &kp HASH &kp DOLLAR &kp PRCNT                       &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp ESC
&kp DEL   &kp F1   &kp F2 &kp F3   &kp F4     &kp F5                          &kp F6    &kp UNDER &kp PLUS  &kp LBRC &kp RBRC &kp PIPE
&trans    &kp F7   &kp F8 &kp F9   &kp F10    &kp F11                         &kp F12   &kp LS(NON_US_HASH) &kp LS(NON_US_BSLH) &kp HOME &kp END &trans
&trans    &trans   &trans &trans   &trans     &trans      &trans &trans       &trans    &trans    &kp HOME &kp PG_DN &kp PG_UP &kp END
                              &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
// ------------------------------------------------------------------------------------------------------------
// |  `   |  1   |  2   |  3   |  4   |  5   |                   |  6   |  7   |  8   |  9   |  0   | ESC  |
// | DEL  | F1   | F2   | F3   | F4   | F5   |                   | F6   |  -   |  =   |  [   |  ]   |  \   |
// |      | F7   | F8   | F9   | F10  | F11  |                   | F12  |ISO # |ISO / | PGUP | PGDN |      |
// |      |      |      |      |      |      |          | |      |      |      | HOME | PGDN | PGUP | END  |
            bindings = <
&kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4  &kp N5                          &kp N6  &kp N7 &kp N8 &kp N9 &kp N0 &kp ESC
&kp DEL   &kp F1 &kp F2 &kp F3 &kp F4  &kp F5                          &kp F6  &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH
&trans    &kp F7 &kp F8 &kp F9 &kp F10 &kp F11                         &kp F12 &kp NON_US_HASH &kp NON_US_BSLH &kp PG_UP &kp PG_DN &trans
&trans    &trans &trans &trans &trans  &trans       &trans &trans      &trans  &trans &kp HOME &kp PG_DN &kp PG_UP &kp END
                            &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        numpad_layer {
            display-name = "Numpad";
// ------------------------------------------------------------------------------------------------------------
// |  `   |CADel |      | PSCR |      |      |                   |      |  7   |  8   |  9   |  -   | BSPC |
// | DEL  |      |      |AltPS | SNIP |      |                   |      |  4   |  5   |  6   |  +   | SPACE|
// |      | F7   | F8   | COPY |PASTE | INS  |                   |      |  1   |  2   |  3   |  *   | ENTER|
// |      |      |      |      |      |      |          | |      |      |  0   |  0   |  .   |  /   | ENTER|
            bindings = <
&kp GRAVE &kp LA(LC(DEL)) &trans &kp PSCRN     &trans &trans                         &trans &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp MINUS &kp BSPC
&kp DEL   &trans          &trans &kp LA(PSCRN) &snip  &trans                         &trans &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp PLUS  &kp SPACE
&trans    &kp F7          &kp F8 &kp LC(INS)   &kp LS(INS) &kp INS                   &trans &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_MULTIPLY &kp ENTER
&trans    &trans          &trans &trans         &trans &trans     &trans &trans        &trans &kp KP_N0 &kp KP_N0 &kp KP_DOT &kp KP_DIVIDE &kp ENTER
                                  &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
// Bluetooth lives here so no Lower key is displaced. Profiles are zero-based
// internally but labeled BT1-BT5 in normal user-facing terms.
// ------------------------------------------------------------------------------------------------------------
// |BTCLR | BT1  | BT2  | BT3  | BT4  | BT5  |                   | BTPRV| BTNEXT|      |      | RESET| BOOT |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &bt BT_PRV &bt BT_NXT &none &none &sys_reset &bootloader
&trans &trans &trans &trans &trans &trans                                           &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                           &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                   &trans &trans            &trans &trans &trans &trans &trans &trans
                        &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
